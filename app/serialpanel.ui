  <property name="styleSheet">
   <string notr="true">QWidget {
    color: #2b2b2b;
    font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei UI&quot;;
    font-size: 10pt;
}
   QWidget#SerialPanel {
       background-color: #f0f0f0;
   }
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d6d6d6;
    border-radius: 6px;
    padding: 4px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #6b7280;
}
QGroupBox#connectionBar {
    background-color: #505259;
    border: none;
    border-radius: 0;
    padding: 4px 8px;
}
QPushButton {
    background-color: #f7f7f7;
    border: 1px solid #c9c9c9;
    border-radius: 4px;
    padding: 3px 12px;
    min-height: 18px;
    color: #2b2b2b;
}
QPushButton:hover {
    background-color: #ffffff;
    border-color: #009bdb;
}
QPushButton:pressed {
    background-color: #e6e6e6;
}
QPushButton:focus {
    border-color: #009bdb;
}
QPushButton:disabled {
    background-color: #f0f0f0;
    border-color: #dcdcdc;
    color: #a0a0a0;
}
QPushButton#openPortButton, QPushButton#sendButton {
    background-color: #009bdb;
    border-color: #008fc9;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#openPortButton:hover, QPushButton#sendButton:hover {
    background-color: #00aff3;
    border-color: #00aff3;
}
QPushButton#openPortButton:pressed, QPushButton#sendButton:pressed {
    background-color: #0086bd;
    border-color: #0086bd;
}
QToolButton#languageButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 3px;
}
QToolButton#languageButton:hover {
    background-color: #676a72;
}
QToolButton#languageButton::menu-indicator {
    image: none;
    width: 0;
}
QComboBox, QLineEdit {
    background-color: #ffffff;
    border: 1px solid #c9c9c9;
    border-radius: 4px;
    padding: 3px 8px;
    min-height: 20px;
    color: #2b2b2b;
    selection-background-color: #009bdb;
    selection-color: #ffffff;
}
QComboBox:hover, QLineEdit:hover {
    border-color: #009bdb;
}
QComboBox:focus, QLineEdit:focus {
    border-color: #009bdb;
}
QComboBox:disabled, QLineEdit:disabled {
    background-color: #f4f4f4;
    border-color: #dcdcdc;
    color: #a0a0a0;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(:/theme/images/chevron-down.png);
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c9c9c9;
    outline: none;
    selection-background-color: #009bdb;
    selection-color: #ffffff;
}
QTextBrowser, QTextEdit, QPlainTextEdit {
    background-color: #fbfbfb;
    border: 1px solid #dcdcdc;
    border-radius: 4px;
    padding: 6px;
    color: #1f2937;
    font-family: &quot;Cascadia Mono&quot;, &quot;Consolas&quot;, monospace;
    selection-background-color: #009bdb;
    selection-color: #ffffff;
}
QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #d6d6d6;
    border-radius: 6px;
    top: -1px;
}
QTabBar::tab {
    background-color: #ececec;
    color: #555555;
    border: 1px solid #d6d6d6;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 16px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #009bdb;
    border-color: #009bdb;
    color: #ffffff;
}
QTabBar::tab:hover:!selected {
    background-color: #f7f7f7;
    color: #2b2b2b;
}
QSplitter {
    background-color: transparent;
}
QSplitter::handle {
    background-color: #e4e4e4;
}
QSplitter::handle:hover {
    background-color: #009bdb;
}
QGroupBox#connectionBar QSplitter::handle {
    background-color: transparent;
}
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #c9c9c9;
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background-color: #a8a8a8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background-color: #c9c9c9;
    min-width: 24px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #a8a8a8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}
QCheckBox {
    spacing: 6px;
}
QToolTip {
    background-color: #ffffff;
    border: 1px solid #c9c9c9;
    padding: 4px 6px;
    color: #2b2b2b;
}
QMenu {
    background-color: #ffffff;
    border: 1px solid #c9c9c9;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #009bdb;
    color: #ffffff;
}
QGroupBox#statusBar {
    background-color: #43454c;
    border: none;
    border-radius: 0;
    padding: 0 8px;
}
QGroupBox#statusBar QLabel {
    color: #eaeaea;
    font-size: 9pt;
}</string>
